# Copy to .env and fill in locally. NEVER commit .env.

# --- ElevenLabs (Phase 4) ---------------------------------------------
# Leave empty during development: the audio module falls back to mock /
# imported audio and will refuse to call the paid API without a key AND
# ELEVENLABS_ALLOW_PAID_CALLS=true.
ELEVENLABS_API_KEY=
ELEVENLABS_ALLOW_PAID_CALLS=false
ELEVENLABS_MODEL_ID=eleven_v4
ELEVENLABS_LANGUAGE_CODE=th
# Sunny → "Pat – Warm Thai Storyteller" (library voice 6x3qYeG3xkaxgXoc66dE)
ELEVENLABS_VOICE_SUNNY=
# Ton → "Suwapoj – ไทย Podcast" (library voice vSL3G4iIBh54RFkRCXHj)
ELEVENLABS_VOICE_HOMEOWNER=
ELEVENLABS_VOICE_TECHNICIAN=
# Narrator → the owner's cloned voice "Thanawat" (ID from the owner's account)
ELEVENLABS_VOICE_NARRATOR=

# --- Rendering -----------------------------------------------------------
# angle (macOS GPU, default) | swangle (software, Linux/CI) | egl
RENDER_GL=angle
# Optional: path to a Chrome Headless Shell binary if Remotion cannot download one.
BROWSER_EXECUTABLE=
# Parallel frame renders. On a 4-core Intel MacBook, 2–3 is a good balance.
RENDER_CONCURRENCY=2
