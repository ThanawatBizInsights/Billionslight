{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "lib": ["DOM", "ES2022"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "@engine/*": ["src/engine/*"], "@schemas/*": ["src/schemas/*"], "@config/*": ["src/config/*"] }
  },
  "include": ["src", "tests", "scripts/**/*.ts", "remotion.config.ts", "vitest.config.ts"]
}
